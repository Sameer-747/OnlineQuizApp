@model QuizPlayViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h2>@Model.Title</h2>
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Answer all questions and click Submit.</p>
    <div class="badge bg-warning text-dark fs-6" id="timer">--:--</div>
</div>

@if (Model.IsTestEvent)
{
    <div id="examWarningBanner" class="alert alert-danger d-none align-items-center justify-content-between mb-3" style="position: sticky; top: 8px; z-index: 1050; cursor: pointer;">
        <div>
            <i class="ti ti-alert-triangle me-1"></i>
            <span id="examWarningText">You left the exam.</span>
            <strong>Click here to re-enter full-screen.</strong>
        </div>
    </div>

    <video id="examCamPreviewPinned" autoplay muted playsinline class="d-none"
           style="position: fixed; bottom: 16px; right: 16px; width: 160px; height: 120px; border-radius: 8px; border: 2px solid #a777e3; z-index: 1040; object-fit: cover; background: #000; transform: scaleX(-1);"></video>
    <canvas id="examCamCanvas" width="320" height="240" class="d-none"></canvas>

    <div id="examInstructions" class="card mb-4" style="border: 2px solid #a777e3;">
        <div class="card-body">
            <h4 class="card-title mb-3"><i class="ti ti-shield-check me-1"></i> Exam Instructions</h4>
            <ul class="mb-3">
                <li>This is a proctored test. Once you start, the screen will switch to full-screen mode.</li>
                <li>Do not switch tabs, open another app, or exit full-screen. You get <strong>2 warnings</strong> &mdash; the <strong>3rd time</strong> you leave the exam, it is <strong>auto-submitted immediately</strong> with whatever answers you've selected so far.</li>
                <li>Your camera stays on for the whole exam. If your face isn't visible or more than one face appears for a few seconds straight, your exam is <strong>auto-submitted immediately &mdash; no warning</strong>.</li>
                <li>The timer keeps running no matter what you do &mdash; it will not pause.</li>
                <li>You get one attempt. Once submitted (manually or automatically), it cannot be retaken.</li>
            </ul>

            <div class="mb-3">
                <div id="camStatus" class="small text-muted mb-2">
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Preparing camera and AI monitoring&hellip;
                </div>
                <video id="examCamPreview" autoplay muted playsinline
                       style="width: 200px; height: 150px; border-radius: 8px; background: #000; object-fit: cover; transform: scaleX(-1);"></video>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="ackCheckbox">
                <label class="form-check-label" for="ackCheckbox">
                    I have read and understood the instructions above.
                </label>
            </div>
            <button type="button" id="startExamBtn" class="btn btn-primary" disabled>
                <i class="ti ti-player-play me-1"></i> Start Exam
            </button>
        </div>
    </div>
}

<div id="quizContent" class="@(Model.IsTestEvent ? "d-none" : "")">
    <form asp-action="Submit" method="post" id="quizForm">
        <input type="hidden" name="QuizId" value="@Model.QuizId" />
        @if (Model.IsTestEvent)
        {
            <input type="hidden" name="TabSwitchCount" id="tabSwitchCountField" value="0" />
            <input type="hidden" name="AutoSubmitted" id="autoSubmittedField" value="false" />
            <input type="hidden" name="ViolationReason" id="violationReasonField" value="" />
        }

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Q@(i + 1). @q.Text</h5>
                    <input type="hidden" name="Answers[@i].QuestionId" value="@q.QuestionId" />
                    @foreach (var opt in q.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="Answers[@i].SelectedOptionId"
                                   id="opt_@opt.OptionId"
                                   value="@opt.OptionId" />
                            <label class="form-check-label" for="opt_@opt.OptionId">
                                @opt.Text
                            </label>
                        </div>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-success">Submit Quiz</button>
    </form>
</div>

@section Scripts {
    @if (Model.IsTestEvent)
    {
        <script src="https://cdn.jsdelivr.net/npm/face-api.js@@0.22.2/dist/face-api.min.js"></script>
    }
    <script>
        (function () {
            let duration = @Model.DurationMinutes * 60; // seconds
            const timerEl = document.getElementById('timer');
            const form = document.getElementById('quizForm');
            const isTestEvent = @(Model.IsTestEvent ? "true" : "false");
            const quizId = @Model.QuizId;
            let isSubmitting = false;
            let tabSwitchCount = 0;
            let camStream = null;
            let camReady = false;

            function updateTimer() {
                const minutes = Math.floor(duration / 60);
                const seconds = duration % 60;
                timerEl.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

                if (duration <= 0) {
                    clearInterval(interval);
                    isSubmitting = true;
                    form.submit();
                    return;
                }
                duration--;
            }

            let interval = null;
            let started = !isTestEvent;

            // Warn before leaving the page (back button, refresh, close tab)
            window.addEventListener('beforeunload', function (e) {
                if (isSubmitting) return;
                e.preventDefault();
                e.returnValue = 'If you leave this page, your quiz attempt will be lost and you will not be able to retake it. Are you sure you want to leave?';
                return e.returnValue;
            });

            // Record how many times the exam window was left, on every submission path
            // (manual submit, time-up auto-submit, or the integrity auto-submit below).
            form.addEventListener('submit', function () {
                isSubmitting = true;
                const field = document.getElementById('tabSwitchCountField');
                if (field) field.value = tabSwitchCount;
                if (camStream) camStream.getTracks().forEach(function (t) { t.stop(); });
            });

            if (!isTestEvent) {
                updateTimer();
                interval = setInterval(updateTimer, 1000);
                return; // regular quizzes: no fullscreen lockdown, no tab-switch/camera monitoring
            }

            // ---- Proctored Test Event flow below ----

            const ackCheckbox = document.getElementById('ackCheckbox');
            const startBtn = document.getElementById('startExamBtn');
            const instructions = document.getElementById('examInstructions');
            const quizContent = document.getElementById('quizContent');
            const warningBanner = document.getElementById('examWarningBanner');
            const warningText = document.getElementById('examWarningText');
            const camPreview = document.getElementById('examCamPreview');
            const camPreviewPinned = document.getElementById('examCamPreviewPinned');
            const camCanvas = document.getElementById('examCamCanvas');
            const camStatus = document.getElementById('camStatus');

            function updateStartButtonState() {
                startBtn.disabled = !(ackCheckbox.checked && camReady);
            }
            ackCheckbox.addEventListener('change', updateStartButtonState);

            function getAntiForgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            function autoSubmit(reason) {
                if (isSubmitting) return;
                isSubmitting = true;
                document.getElementById('autoSubmittedField').value = 'true';
                document.getElementById('tabSwitchCountField').value = tabSwitchCount;
                document.getElementById('violationReasonField').value = reason || '';
                if (camCheckInterval) clearInterval(camCheckInterval);
                if (camStream) camStream.getTracks().forEach(function (t) { t.stop(); });
                form.submit();
            }

            // ---- Tab/app-switch + full-screen strike system: 2 warnings, 3rd = instant submit ----

            const MAX_WARNINGS = 2;
            let hadFullscreen = false;
            let lastViolationAt = 0;
            let warningHideTimer = null;

            function isFullscreenActive() {
                return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
            }

            function requestFullscreen() {
                const el = document.documentElement;
                const req = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
                if (req) {
                    Promise.resolve(req.call(el)).catch(function () {
                        // Some browsers/environments block full-screen; tab-switch detection
                        // still covers most of the exam-integrity requirement on its own.
                    });
                }
            }

            function showWarning(reason) {
                const remaining = MAX_WARNINGS - tabSwitchCount;
                warningText.textContent = 'Warning ' + tabSwitchCount + ' of ' + MAX_WARNINGS + ': you left the exam (' + reason + ').' +
                    (remaining > 0
                        ? ' ' + remaining + ' more time' + (remaining === 1 ? '' : 's') + ' and your exam will be auto-submitted immediately.'
                        : '');
                warningBanner.classList.remove('d-none');
                warningBanner.classList.add('d-flex');
                if (warningHideTimer) clearTimeout(warningHideTimer);
                warningHideTimer = setTimeout(function () {
                    warningBanner.classList.add('d-none');
                    warningBanner.classList.remove('d-flex');
                }, 6000);
            }

            // Called for any "left the exam" signal: tab switch, app switch, or exiting
            // full-screen. Debounced since one physical action (e.g. switching tabs) can
            // fire several of these events within the same instant.
            function registerViolation(reason) {
                if (!started || isSubmitting) return;
                const now = Date.now();
                if (now - lastViolationAt < 800) return;
                lastViolationAt = now;
                tabSwitchCount++;

                if (tabSwitchCount > MAX_WARNINGS) {
                    autoSubmit('Left the exam ' + tabSwitchCount + ' times (tab switch, app switch, or exited full-screen).');
                } else {
                    showWarning(reason);
                }
            }

            document.addEventListener('visibilitychange', function () {
                if (document.hidden) registerViolation('switched tabs');
            });

            // Catches switching to another application (e.g. the Dock, Cmd+Tab, another
            // window) that doesn't necessarily hide the tab, so visibilitychange alone
            // would miss it.
            let startedAt = 0;
            window.addEventListener('blur', function () {
                if (Date.now() - startedAt < 1500) return; // ignore the fullscreen-entry transition itself
                registerViolation('switched to another app or window');
            });

            function onFullscreenChange() {
                if (isFullscreenActive()) {
                    hadFullscreen = true;
                } else if (hadFullscreen && started && !isSubmitting) {
                    hadFullscreen = false;
                    registerViolation('exited full-screen');
                }
            }
            document.addEventListener('fullscreenchange', onFullscreenChange);
            document.addEventListener('webkitfullscreenchange', onFullscreenChange);
            document.addEventListener('MSFullscreenChange', onFullscreenChange);

            // Optional: clicking the warning banner re-enters full-screen (browsers
            // require a fresh user click to do this - it can't happen automatically).
            warningBanner.addEventListener('click', function () {
                requestFullscreen();
            });

            // ---- Camera-based proctoring: no face / multiple faces in frame ----
            // (Phone/device detection via coco-ssd + tfjs was dropped - its browser build
            // proved too fragile in practice across CDN/version combos to rely on.)

            // The npm package doesn't publish model weight files, only the GitHub repo does,
            // so these load from jsdelivr's GitHub CDN instead of the npm one.
            const FACE_MODEL_URL = 'https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@@master/weights';
            const CAM_POLL_MS = 2000;
            const CAM_STREAK_THRESHOLD = 3; // ~6s sustained at a 2s poll interval, no warning - instant submit
            let camCheckInterval = null;
            let noFaceStreak = 0;
            let multiFaceStreak = 0;

            async function setupCamera() {
                function showCamError(message) {
                    camReady = false;
                    camStatus.innerHTML = '<i class="ti ti-alert-triangle text-danger me-1"></i> ' + message +
                        ' <button type="button" id="camRetryBtn" class="btn btn-sm btn-outline-primary ms-2">Retry</button>';
                    const retryBtn = document.getElementById('camRetryBtn');
                    if (retryBtn) retryBtn.addEventListener('click', setupCamera);
                    updateStartButtonState();
                }

                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    showCamError('This browser/connection does not support camera access (it requires HTTPS and a modern browser).');
                    return;
                }

                try {
                    camStatus.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Loading face-detection model&hellip;';
                    await faceapi.nets.tinyFaceDetector.loadFromUri(FACE_MODEL_URL);
                } catch (faceErr) {
                    showCamError('Could not load the face-detection model (' + (faceErr && faceErr.message ? faceErr.message : String(faceErr)) + '). Check your internet connection and retry.');
                    return;
                }

                try {
                    camStatus.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Requesting camera access&hellip;';
                    camStream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 }, audio: false });
                    camPreview.srcObject = camStream;
                    camPreviewPinned.srcObject = camStream;

                    camStream.getVideoTracks()[0].addEventListener('ended', function () {
                        if (started && !isSubmitting) {
                            autoSubmit('Camera access was lost or turned off during the exam.');
                        }
                    });

                    camReady = true;
                    camStatus.innerHTML = '<i class="ti ti-circle-check text-success me-1"></i> Camera and AI monitoring ready.';
                    updateStartButtonState();
                } catch (camErr) {
                    let msg = 'Camera access is required for this exam.';
                    if (camErr && camErr.name === 'NotAllowedError') {
                        msg = 'Camera permission was denied. Click the camera icon in the address bar (or check System Settings &gt; Privacy &amp; Security &gt; Camera on Mac) to allow this site, then retry.';
                    } else if (camErr && camErr.name === 'NotFoundError') {
                        msg = 'No camera was found on this device. A working camera is required for this exam.';
                    } else if (camErr && camErr.name === 'NotReadableError') {
                        msg = 'Your camera is already in use by another app. Close any other app using the camera and retry.';
                    } else if (camErr && camErr.message) {
                        msg = 'Camera error (' + camErr.name + '): ' + camErr.message;
                    }
                    showCamError(msg);
                }
            }
            setupCamera();

            function reportCameraViolation(reason, dataUrl) {
                fetch('/Quiz/ReportCameraViolation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ quizId: quizId, reason: reason, imageData: dataUrl })
                }).catch(function () {
                    // Best-effort evidence upload; never let this block the actual auto-submit.
                });
            }

            async function runCameraCheck() {
                if (!started || isSubmitting || !camReady) return;
                try {
                    const ctx = camCanvas.getContext('2d');
                    ctx.drawImage(camPreview, 0, 0, camCanvas.width, camCanvas.height);

                    const faces = await faceapi.detectAllFaces(camCanvas, new faceapi.TinyFaceDetectorOptions());

                    let issue = null;
                    if (faces.length === 0) issue = 'noFace';
                    else if (faces.length > 1) issue = 'multiFace';

                    noFaceStreak = issue === 'noFace' ? noFaceStreak + 1 : 0;
                    multiFaceStreak = issue === 'multiFace' ? multiFaceStreak + 1 : 0;

                    let triggered = null;
                    if (noFaceStreak >= CAM_STREAK_THRESHOLD) triggered = 'No face detected in camera for several seconds.';
                    else if (multiFaceStreak >= CAM_STREAK_THRESHOLD) triggered = 'Multiple faces detected in camera.';

                    if (triggered) {
                        const dataUrl = camCanvas.toDataURL('image/jpeg', 0.6);
                        reportCameraViolation(triggered, dataUrl);
                        autoSubmit('Camera: ' + triggered);
                    }
                } catch (err) {
                    // A single failed detection round should never crash the exam - just skip it.
                }
            }

            startBtn.addEventListener('click', function () {
                if (!ackCheckbox.checked || !camReady) return;
                instructions.classList.add('d-none');
                quizContent.classList.remove('d-none');
                camPreviewPinned.classList.remove('d-none');
                started = true;
                startedAt = Date.now();
                requestFullscreen();
                updateTimer();
                interval = setInterval(updateTimer, 1000);
                camCheckInterval = setInterval(runCameraCheck, CAM_POLL_MS);
            });
        })();
    </script>
}
