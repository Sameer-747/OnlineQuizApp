@model List<TestEvent>
@{
    ViewData["Title"] = "Test Events";
    var ist = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="ti ti-code me-2"></i>Multi-Language Test Events</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Test Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p class="text-muted">
    Create one event covering several programming languages — AI generates a quiz per language,
    and each student in the section is randomly assigned exactly one to attempt.
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No test events yet. Click "New Test Event" to create one.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Section</th>
                <th>Languages</th>
                <th>Students Assigned</th>
                <th>Window (IST)</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var te in Model)
            {
                var startIst = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(te.StartTime, DateTimeKind.Utc), ist);
                var endIst = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(te.EndTime, DateTimeKind.Utc), ist);
                string badgeClass = te.Status switch
                {
                    "Active" => "bg-success",
                    "Upcoming" => "bg-warning text-dark",
                    _ => "bg-secondary"
                };

                <tr>
                    <td>@te.Title</td>
                    <td>@te.Section?.Name</td>
                    <td>@te.Quizzes.Count</td>
                    <td>@te.Assignments.Count</td>
                    <td>
                        @startIst.ToString("dd MMM, hh:mm tt") &rarr; @endIst.ToString("dd MMM, hh:mm tt")
                    </td>
                    <td><span class="badge @badgeClass">@te.Status</span></td>
                    <td>
                        <a asp-action="Results" asp-route-id="@te.Id" class="btn btn-sm btn-outline-primary">Results</a>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-event-btn"
                                data-id="@te.Id" data-title="@te.Title" data-expired="@(te.Status == "Expired" ? "true" : "false")">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="deleteEventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ti ti-alert-triangle me-2 text-danger"></i>Delete Test Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="deleteEventMessage" class="mb-0"></p>
                    <p id="deleteEventStatus" class="mb-0 mt-2 small text-muted d-none"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" id="deleteEventCancelBtn" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteEventForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="deleteEventSubmitBtn" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            var deleteEventForm = document.getElementById('deleteEventForm');
            var deleteEventStatus = document.getElementById('deleteEventStatus');
            var deleteEventSubmitBtn = document.getElementById('deleteEventSubmitBtn');
            var deleteEventCancelBtn = document.getElementById('deleteEventCancelBtn');

            document.querySelectorAll('.delete-event-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.dataset.id;
                    var title = this.dataset.title;
                    var isExpired = this.dataset.expired === 'true';

                    deleteEventForm.action = '/Admin/TestEvents/Delete/' + id;
                    deleteEventForm.dataset.pending = 'false';

                    var msg = 'Delete "' + title + '" and all its language quizzes?';
                    if (isExpired) {
                        msg += ' This also permanently deletes any student attempts already recorded for it.';
                    }
                    msg += ' This cannot be undone.';
                    document.getElementById('deleteEventMessage').textContent = msg;

                    deleteEventStatus.classList.add('d-none');
                    deleteEventStatus.textContent = '';
                    deleteEventStatus.classList.remove('text-danger');
                    deleteEventSubmitBtn.disabled = false;
                    deleteEventSubmitBtn.innerHTML = '<i class="ti ti-trash me-1"></i>Delete';

                    bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteEventModal')).show();
                });
            });

            deleteEventForm.addEventListener('submit', function (e) {
                e.preventDefault();
                if (deleteEventForm.dataset.pending === 'true') return;
                deleteEventForm.dataset.pending = 'true';

                deleteEventSubmitBtn.disabled = true;
                deleteEventCancelBtn.disabled = true;
                deleteEventSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Deleting...';

                deleteEventStatus.classList.remove('d-none', 'text-danger');
                deleteEventStatus.textContent = 'Working on it - this can take up to a minute if the server was idle.';

                var slowNoticeTimer = setTimeout(function () {
                    deleteEventStatus.textContent = 'Still working... the free-tier server can be slow to wake up. Please keep waiting.';
                }, 8000);

                var token = deleteEventForm.querySelector('input[name="__RequestVerificationToken"]').value;

                fetch(deleteEventForm.action, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: new FormData(deleteEventForm)
                })
                    .then(function (response) {
                        clearTimeout(slowNoticeTimer);
                        if (response.ok || response.redirected) {
                            deleteEventStatus.textContent = 'Done. Refreshing...';
                            window.location.href = response.url || window.location.href;
                        } else {
                            throw new Error('Server responded with status ' + response.status);
                        }
                    })
                    .catch(function (err) {
                        clearTimeout(slowNoticeTimer);
                        deleteEventForm.dataset.pending = 'false';
                        deleteEventSubmitBtn.disabled = false;
                        deleteEventCancelBtn.disabled = false;
                        deleteEventSubmitBtn.innerHTML = '<i class="ti ti-trash me-1"></i>Delete';
                        deleteEventStatus.classList.add('text-danger');
                        deleteEventStatus.textContent = 'Something went wrong (' + err.message + '). Please try again.';
                    });
            });
        </script>
    }
}
