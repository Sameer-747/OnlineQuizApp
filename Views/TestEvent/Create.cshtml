@{
    ViewData["Title"] = "New Test Event";
    bool isSuper = ViewBag.IsSuper ?? false;
    var sections = ViewBag.Sections as List<Section> ?? new List<Section>();
}

<div class="d-flex align-items-center gap-3 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="ti ti-arrow-left me-1"></i>Back
    </a>
    <h2 class="mb-0"><i class="ti ti-code me-2"></i>New Multi-Language Test Event</h2>
</div>

<div id="te-app"
     data-is-super="@isSuper.ToString().ToLower()"
     data-sections='@Html.Raw(Json.Serialize(sections.Select(s => new { id = s.Id, name = s.Name })))'
     data-token="@Html.AntiForgeryToken()"></div>

@Html.AntiForgeryToken()

<script src="https://unpkg.com/react@18/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>

<script type="text/babel">
const { useState } = React;

const COMMON_LANGUAGES = ["Python", "Java", "C++", "C", "C#", "JavaScript", "SQL", "HTML/CSS"];

function TestEventApp({ isSuper, sections }) {
    const [title, setTitle] = useState('');
    const [sectionId, setSectionId] = useState(sections[0]?.id || '');
    const [startTime, setStartTime] = useState('');
    const [endTime, setEndTime] = useState('');
    const [duration, setDuration] = useState(15);
    const [count, setCount] = useState(10);
    const [difficulty, setDifficulty] = useState('medium');
    const [selectedLangs, setSelectedLangs] = useState([]);
    const [customLang, setCustomLang] = useState('');
    const [submitting, setSubmitting] = useState(false);
    const [error, setError] = useState('');
    const [result, setResult] = useState(null);

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function toggleLang(lang) {
        setSelectedLangs(prev => prev.includes(lang) ? prev.filter(l => l !== lang) : [...prev, lang]);
    }

    function addCustomLang() {
        const trimmed = customLang.trim();
        if (trimmed && !selectedLangs.includes(trimmed)) {
            setSelectedLangs(prev => [...prev, trimmed]);
        }
        setCustomLang('');
    }

    async function submit() {
        setError('');
        if (!title.trim()) { setError('Please enter a title.'); return; }
        if (selectedLangs.length === 0) { setError('Select at least one language.'); return; }
        if (!startTime || !endTime) { setError('Please set a start and end time.'); return; }
        if (isSuper && !sectionId) { setError('Please choose a section.'); return; }

        setSubmitting(true);
        try {
            const res = await fetch('/Admin/TestEvents/CreateAndPost', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({
                    title,
                    sectionId: isSuper ? parseInt(sectionId) : null,
                    startTime,
                    endTime,
                    durationMinutes: parseInt(duration),
                    questionCount: parseInt(count),
                    difficulty,
                    languages: selectedLangs
                })
            });

            const data = await res.json().catch(() => ({}));

            if (!res.ok) {
                setError(data.error || 'Failed to create test event.');
                return;
            }

            setResult(data);
        } catch (e) {
            setError('Something went wrong. Please try again.');
        } finally {
            setSubmitting(false);
        }
    }

    if (result) {
        return (
            <div className="card" style={{maxWidth: '640px'}}>
                <div className="card-body">
                    <h5 className="text-success mb-3"><i className="ti ti-check me-2"></i>Test event posted!</h5>
                    <p>Generated languages: <strong>{result.languagesGenerated.join(', ')}</strong></p>
                    {result.failedLanguages.length > 0 && (
                        <p className="text-danger">Could not generate: {result.failedLanguages.join(', ')}</p>
                    )}
                    <p>{result.studentsAssigned} student(s) assigned.</p>
                    <a href={`/Admin/TestEvents/Results/${result.eventId}`} className="btn btn-primary">
                        View Results Dashboard
                    </a>
                </div>
            </div>
        );
    }

    return (
        <div className="card" style={{maxWidth: '720px'}}>
            <div className="card-body">
                <div className="mb-3">
                    <label className="form-label fw-semibold">Title</label>
                    <input className="form-control" placeholder="e.g. Mid-Term Coding Assessment"
                        value={title} onChange={e => setTitle(e.target.value)} />
                </div>

                {isSuper && (
                    <div className="mb-3">
                        <label className="form-label fw-semibold">Section</label>
                        <select className="form-select" value={sectionId} onChange={e => setSectionId(e.target.value)}>
                            {sections.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
                        </select>
                    </div>
                )}

                <div className="row g-3 mb-3">
                    <div className="col-6">
                        <label className="form-label fw-semibold">Starts At</label>
                        <input type="datetime-local" className="form-control" value={startTime}
                            onChange={e => setStartTime(e.target.value)} />
                    </div>
                    <div className="col-6">
                        <label className="form-label fw-semibold">Ends At</label>
                        <input type="datetime-local" className="form-control" value={endTime}
                            onChange={e => setEndTime(e.target.value)} />
                    </div>
                </div>

                <div className="row g-3 mb-3">
                    <div className="col-4">
                        <label className="form-label fw-semibold">Duration (min)</label>
                        <input type="number" min="1" max="240" className="form-control" value={duration}
                            onChange={e => setDuration(e.target.value)} />
                    </div>
                    <div className="col-4">
                        <label className="form-label fw-semibold">Questions / Language</label>
                        <select className="form-select" value={count} onChange={e => setCount(e.target.value)}>
                            {[5, 10, 15, 20, 25, 30].map(n => <option key={n} value={n}>{n}</option>)}
                        </select>
                    </div>
                    <div className="col-4">
                        <label className="form-label fw-semibold">Difficulty</label>
                        <select className="form-select" value={difficulty} onChange={e => setDifficulty(e.target.value)}>
                            <option value="easy">Easy</option>
                            <option value="medium">Medium</option>
                            <option value="hard">Hard</option>
                        </select>
                    </div>
                </div>

                <div className="mb-3">
                    <label className="form-label fw-semibold">Languages</label>
                    <div className="d-flex flex-wrap gap-2 mb-2">
                        {COMMON_LANGUAGES.map(lang => (
                            <button type="button" key={lang}
                                className={`btn btn-sm ${selectedLangs.includes(lang) ? 'btn-primary' : 'btn-outline-primary'}`}
                                onClick={() => toggleLang(lang)}>
                                {lang}
                            </button>
                        ))}
                    </div>
                    <div className="input-group input-group-sm" style={{maxWidth: '320px'}}>
                        <input className="form-control" placeholder="Add another language..."
                            value={customLang} onChange={e => setCustomLang(e.target.value)}
                            onKeyDown={e => e.key === 'Enter' && addCustomLang()} />
                        <button className="btn btn-outline-secondary" type="button" onClick={addCustomLang}>Add</button>
                    </div>
                    {selectedLangs.length > 0 && (
                        <div className="mt-2 d-flex flex-wrap gap-2">
                            {selectedLangs.map(lang => (
                                <span key={lang} className="badge bg-secondary d-flex align-items-center gap-1" style={{fontSize: '0.85rem'}}>
                                    {lang}
                                    <i className="ti ti-x" style={{cursor: 'pointer'}} onClick={() => toggleLang(lang)}></i>
                                </span>
                            ))}
                        </div>
                    )}
                </div>

                {error && <div className="alert alert-danger">{error}</div>}

                <button className="btn btn-primary w-100" onClick={submit} disabled={submitting}>
                    {submitting
                        ? <><span className="spinner-border spinner-border-sm me-2"></span>Generating {selectedLangs.length || ''} language quiz(zes)...</>
                        : <><i className="ti ti-sparkles me-2"></i>Generate &amp; Post Test</>}
                </button>
            </div>
        </div>
    );
}

const container = document.getElementById('te-app');
const isSuper = container.getAttribute('data-is-super') === 'true';
const sections = JSON.parse(container.getAttribute('data-sections') || '[]');
ReactDOM.render(<TestEventApp isSuper={isSuper} sections={sections} />, container);
</script>
