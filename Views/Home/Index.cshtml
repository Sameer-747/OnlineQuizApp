@model List<Category>
@{
    ViewData["Title"] = "Home";
    int activeTestCount = ViewBag.ActiveTestCount ?? 0;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="hero-card text-center mb-5">
    <div class="hero-icon-badge"><i class="ti ti-bulb"></i></div>
    <h1 class="display-5 fw-bold mb-2">Welcome to the Online Quiz App</h1>
    <p class="lead mb-4" style="color: #5b5b7a;">Test your knowledge, get instant results, and earn badges along the way.</p>

    <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
        <a asp-controller="Quiz" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="ti ti-rocket me-1"></i> Browse All Quizzes
        </a>
        @if (!isAuthenticated)
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">
                <i class="ti ti-login-2 me-1"></i> Log in
            </a>
        }
    </div>

    <div class="hero-highlights">
        <div class="hero-highlight"><i class="ti ti-category"></i><span>Multiple Categories</span></div>
        <div class="hero-highlight"><i class="ti ti-bolt"></i><span>Instant Results</span></div>
        <div class="hero-highlight"><i class="ti ti-award"></i><span>Earn Badges</span></div>
        <div class="hero-highlight"><i class="ti ti-chart-line"></i><span>Track Progress</span></div>
    </div>
</div>

@if (activeTestCount > 0)
{
    <div class="card mb-4" style="border: none; background: linear-gradient(135deg, #6e8efb, #a777e3); color: #fff;">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="d-inline-flex align-items-center justify-content-center"
                      style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,0.2);">
                    <i class="ti ti-code" style="font-size:24px"></i>
                </span>
                <div>
                    <h5 class="mb-1">You have a live test event!</h5>
                    <p class="mb-0" style="opacity:0.9;">
                        @activeTestCount test@(activeTestCount == 1 ? " is" : "s are") open right now - don't miss the window.
                    </p>
                </div>
            </div>
            <a asp-controller="MyTests" asp-action="Index" class="btn btn-light fw-semibold">
                <i class="ti ti-arrow-right me-1"></i>Go to My Tests
            </a>
        </div>
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center"
                                  style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#6e8efb,#a777e3);color:#fff;">
                                <i class="ti ti-category" style="font-size:20px"></i>
                            </span>
                            <h5 class="card-title mb-0">@category.Name</h5>
                        </div>
                        <p class="card-text flex-grow-1" style="color:#5b5b7a;">
                            <i class="ti ti-list-check me-1"></i>@category.Quizzes.Count quiz(zes) available
                        </p>
                        <a asp-controller="Quiz" asp-action="Index" asp-route-categoryId="@category.Id" class="btn btn-outline-primary btn-sm align-self-start">
                            <i class="ti ti-arrow-right me-1"></i> View Quizzes
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="ti ti-mood-empty"></i></div>
        <h4>No categories yet</h4>
        <p>Check back soon &mdash; new quiz categories are on the way!</p>
    </div>
}
