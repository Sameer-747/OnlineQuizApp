@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Quiz App</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    bool isSuperAdmin = User.Identity?.IsAuthenticated == true
        && User.Identity.Name?.ToLower() == "admin@quizapp.com";
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string> activeIf = c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<body>
@if (isSuperAdmin)
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser!.FullName : User.Identity?.Name;

    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <i class="ti ti-sparkles"></i>
                <span>Online Quiz App</span>
            </a>

            <div class="sidebar-badge">
                <i class="ti ti-shield-check me-1"></i>Super Admin
            </div>

            <nav class="sidebar-nav">
                <a class="@activeIf("Home")" asp-controller="Home" asp-action="Index"><i class="ti ti-home"></i>Home</a>
                <a class="@activeIf("Quiz")" asp-controller="Quiz" asp-action="Index"><i class="ti ti-list-details"></i>Quizzes</a>
                <a class="@activeIf("Category")" asp-controller="Category" asp-action="Index"><i class="ti ti-category"></i>Categories</a>
                <a class="@activeIf("QuizAdmin")" asp-controller="QuizAdmin" asp-action="Index"><i class="ti ti-settings"></i>Manage Quizzes</a>
                <a class="@activeIf("TestEvent")" asp-controller="TestEvent" asp-action="Index"><i class="ti ti-code"></i>Test Events</a>
                <a class="@activeIf("ResultsAdmin")" asp-controller="ResultsAdmin" asp-action="Index"><i class="ti ti-chart-bar"></i>Student Results</a>

                <div class="sidebar-divider"></div>

                <a class="@activeIf("AdminManagement")" asp-controller="AdminManagement" asp-action="Index"><i class="ti ti-shield-check"></i>Manage Admins</a>
                <a class="@activeIf("SectionManagement")" asp-controller="SectionManagement" asp-action="Index"><i class="ti ti-building-community"></i>Manage Sections</a>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Profile" asp-action="Index" class="sidebar-user">
                    <i class="ti ti-user-circle"></i>
                    <span>@displayName</span>
                </a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="sidebar-logout"><i class="ti ti-logout"></i>Logout</button>
                </form>
            </div>
        </aside>

        <div class="admin-content">
            <main role="main" class="container-fluid px-4 py-4">
                @RenderBody()
            </main>
            <footer class="text-center py-3 text-muted small">
                &copy; @DateTime.Now.Year - Online Quiz App
            </footer>
        </div>
    </div>
}
else
{
    <header>
        <nav class="navbar navbar-expand-sm navbar-light glass-navbar mb-4">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="ti ti-sparkles" style="font-size:22px"></i>
                    Online Quiz App
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="ti ti-home me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Quiz" asp-action="Index"><i class="ti ti-list-details me-1"></i>Quizzes</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Quiz" asp-action="History"><i class="ti ti-history me-1"></i>My History</a>
                            </li>
                            @if (!User.IsInRole("Admin"))
                            {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Quiz" asp-action="MyBadges"><i class="ti ti-award me-1"></i>My Badges</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MyTests" asp-action="Index"><i class="ti ti-code me-1"></i>My Tests</a>
                            </li>
                            }
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Category" asp-action="Index"><i class="ti ti-category me-1"></i>Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="QuizAdmin" asp-action="Index"><i class="ti ti-settings me-1"></i>Manage Quizzes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TestEvent" asp-action="Index"><i class="ti ti-code me-1"></i>Test Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ResultsAdmin" asp-action="Index"><i class="ti ti-chart-bar me-1"></i>Student Results</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-footer text-center py-3 mt-5">
        <div class="container">
            &copy; @DateTime.Now.Year - Online Quiz App
        </div>
    </footer>
}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
