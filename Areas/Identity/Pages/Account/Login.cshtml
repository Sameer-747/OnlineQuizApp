@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-icon-badge"><i class="ti ti-shield-lock"></i></div>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Log in to continue your quiz journey</p>

        @if (TempData["ResetSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["ResetSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="auth-toggle" role="group">
            <button type="button" id="studentTabBtn" onclick="showTab('student')">Student Login</button>
            <button type="button" id="adminTabBtn" onclick="showTab('admin')">Admin Login</button>
        </div>

        <form id="account" method="post">
            <input type="hidden" asp-for="Input.LoginType" id="loginTypeInput" value="student" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div id="studentFields">
                <div class="form-floating mb-3">
                    <input asp-for="Input.RollNumber" class="form-control" autocomplete="username" placeholder="Roll Number" />
                    <label asp-for="Input.RollNumber"><i class="ti ti-id-badge-2 me-1"></i>Roll Number</label>
                </div>
                <div class="form-floating mb-3">
                    <select asp-for="Input.SectionId" asp-items="Model.Sections" class="form-select">
                        <option value="">-- Select your Section --</option>
                    </select>
                    <label asp-for="Input.SectionId">Section</label>
                </div>
            </div>

            <div id="adminFields" style="display:none">
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email"><i class="ti ti-mail me-1"></i>Email</label>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="password" />
                <label asp-for="Input.Password"><i class="ti ti-lock me-1"></i>Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>
            <div>
                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                    <i class="ti ti-login-2 me-1"></i> Log in
                </button>
            </div>
            <div class="auth-footer-links" id="studentAuthLinks">
                <a asp-page="./StudentRegister" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Register as a new student</a>
                <a asp-page="./ForgotPassword" class="auth-link">Forgot your password?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(type) {
            document.getElementById('loginTypeInput').value = type;
            document.getElementById('studentFields').style.display = type === 'student' ? 'block' : 'none';
            document.getElementById('adminFields').style.display = type === 'admin' ? 'block' : 'none';
            document.getElementById('studentAuthLinks').style.display = type === 'student' ? 'flex' : 'none';
            document.getElementById('studentTabBtn').classList.toggle('active', type === 'student');
            document.getElementById('adminTabBtn').classList.toggle('active', type === 'admin');
        }
        showTab('student');
    </script>
}
