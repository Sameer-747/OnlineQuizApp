@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">
    Verify your account details below to set a new password. No email is sent - your new password takes effect immediately.
</p>

<div class="row">
    <div class="col-md-6">
        <section>
            <div class="btn-group mb-3 w-100" role="group">
                <button type="button" class="btn btn-outline-primary" id="studentTabBtn" onclick="showTab('student')">Student</button>
                <button type="button" class="btn btn-outline-primary" id="adminTabBtn" onclick="showTab('admin')">Admin</button>
            </div>

            <form method="post">
                <input type="hidden" asp-for="Input.ResetType" id="resetTypeInput" value="student" />
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div id="studentFields">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.RollNumber" class="form-control" placeholder="Roll Number" />
                        <label asp-for="Input.RollNumber">Roll Number</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="Input.SectionId" asp-items="Model.Sections" class="form-select">
                            <option value="">-- Select your Section --</option>
                        </select>
                        <label asp-for="Input.SectionId">Section</label>
                    </div>
                </div>

                <div id="adminFields" style="display:none">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.FullName" class="form-control" placeholder="Full Name" />
                    <label asp-for="Input.FullName">Full Name (as registered)</label>
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="New Password" />
                    <label asp-for="Input.NewPassword">New Password</label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm New Password" />
                    <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>

                <div class="mt-2">
                    <a asp-page="./Login" class="auth-link">Back to Log in</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(type) {
            document.getElementById('resetTypeInput').value = type;
            document.getElementById('studentFields').style.display = type === 'student' ? 'block' : 'none';
            document.getElementById('adminFields').style.display = type === 'admin' ? 'block' : 'none';
            document.getElementById('studentTabBtn').classList.toggle('btn-primary', type === 'student');
            document.getElementById('studentTabBtn').classList.toggle('btn-outline-primary', type !== 'student');
            document.getElementById('adminTabBtn').classList.toggle('btn-primary', type === 'admin');
            document.getElementById('adminTabBtn').classList.toggle('btn-outline-primary', type !== 'admin');
        }
        showTab('student');
    </script>
}
