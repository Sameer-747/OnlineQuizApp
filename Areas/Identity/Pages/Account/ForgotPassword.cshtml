@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-icon-badge"><i class="ti ti-key"></i></div>
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-subtitle">
            Verify your account details below to set a new password &mdash; no email needed, it takes effect immediately.
        </p>

        <div class="auth-toggle" role="group">
            <button type="button" id="studentTabBtn" onclick="showTab('student')">Student</button>
            <button type="button" id="adminTabBtn" onclick="showTab('admin')">Admin</button>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Input.ResetType" id="resetTypeInput" value="student" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div id="studentFields">
                <div class="form-floating mb-3">
                    <input asp-for="Input.RollNumber" class="form-control" placeholder="Roll Number" />
                    <label asp-for="Input.RollNumber"><i class="ti ti-id-badge-2 me-1"></i>Roll Number</label>
                </div>
                <div class="form-floating mb-3">
                    <select asp-for="Input.SectionId" asp-items="Model.Sections" class="form-select">
                        <option value="">-- Select your Section --</option>
                    </select>
                    <label asp-for="Input.SectionId">Section</label>
                </div>
            </div>

            <div id="adminFields" style="display:none">
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Input.Email"><i class="ti ti-mail me-1"></i>Email</label>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.FullName" class="form-control" placeholder="Full Name" />
                <label asp-for="Input.FullName">Full Name (as registered)</label>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="New Password" />
                <label asp-for="Input.NewPassword"><i class="ti ti-lock me-1"></i>New Password</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm New Password" />
                <label asp-for="Input.ConfirmPassword"><i class="ti ti-lock me-1"></i>Confirm New Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">
                <i class="ti ti-refresh me-1"></i> Reset Password
            </button>

            <div class="auth-footer-links">
                <a asp-page="./Login" class="auth-link">Back to Log in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(type) {
            document.getElementById('resetTypeInput').value = type;
            document.getElementById('studentFields').style.display = type === 'student' ? 'block' : 'none';
            document.getElementById('adminFields').style.display = type === 'admin' ? 'block' : 'none';
            document.getElementById('studentTabBtn').classList.toggle('active', type === 'student');
            document.getElementById('adminTabBtn').classList.toggle('active', type === 'admin');
        }
        showTab('student');
    </script>
}
